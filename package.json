{
  "name": "project-name",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prisma:generate": "prisma generate",
    "db:indexes": "ts-node -r tsconfig-paths/register src/initialScript/bootstrap-mongo-indexes.ts",
    "audit:rollout": "ts-node -r tsconfig-paths/register src/initialScript/audit-rollout.ts",
    "seed": "ts-node -r tsconfig-paths/register src/initialScript/seed.ts",
    "seed:demo": "ts-node -r tsconfig-paths/register src/initialScript/seed-demo.ts",
    "seed:demo:verify": "ts-node -r tsconfig-paths/register src/initialScript/verify-demo.ts",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --max-warnings=0",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand",
    "test:integration": "node --env-file-if-exists=.env.flowtest ./node_modules/jest/bin/jest.js --config ./test/jest-integration.json --runInBand",
    "test:guard": "jest --config ./test/jest-guard.json --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --runInBand && pnpm test:coverage:verify",
    "test:coverage:verify": "tsx test/coverage/verify-coverage.ts",
    "test:architecture": "tsx test/architecture/verify-boundaries.ts",
    "test:supply-chain-policy": "node test/supply-chain/verify-security-policy.mjs self-test",
    "test:rollback-drill": "node test/deploy/run-immutable-rollback-drill.mjs",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "node --env-file-if-exists=.env.flowtest ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json --runInBand --detectOpenHandles --forceExit",
    "test:flow": "tsx test/flows/run-all.ts",
    "flowtest": "tsx test/flows/run-all.ts",
    "flowtest:one": "tsx",
    "verify": "pnpm lint && pnpm test:architecture && pnpm build && pnpm test:unit && pnpm test:guard && pnpm test:integration"
  },
  "dependencies": {
    "@anatine/zod-openapi": "^2.2.8",
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.27",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.3",
    "@nestjs/websockets": "^11.1.27",
    "@prisma/client": "6.19.3",
    "@react-pdf/renderer": "^4.5.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.79.1",
    "dotenv": "^17.4.2",
    "google-auth-library": "^10.7.0",
    "ioredis": "^5.11.1",
    "nestjs-zod": "^5.4.0",
    "react": "^19.2.7",
    "react-email": "^6.6.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.12.4",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "mongodb": "^7.4.0",
    "prettier": "^3.4.2",
    "prisma": "6.19.3",
    "socket.io-client": "^4.8.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts",
      "tsx"
    ],
    "rootDir": "src",
    "testMatch": [
      "<rootDir>/**/*.spec.ts"
    ],
    "testPathIgnorePatterns": [
      "/test/integration/",
      "/test/flows/"
    ],
    "transform": {
      "^.+\\.(t|j)sx?$": "ts-jest"
    },
    "globalSetup": "<rootDir>/../test/jest-global-setup.ts",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1",
      "^@react-pdf/renderer$": "<rootDir>/infrastructure/pdf/react-pdf-renderer.jest-mock.ts"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "packageManager": "pnpm@11.1.3"
}
