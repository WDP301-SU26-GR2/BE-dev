PORT=
SALT_OR_ROUNDS=
NAME_APP=Mangaka
NODE_ENV=development
# Production: random secret >= 32 bytes, no placeholder values.
API_KEY=
AUTH_TYPE_KEY=

DATABASE_URL=mongodb://localhost:27017/Mangaka?replicaSet=rs0
REDIS_URL=redis://localhost:6379

# Production: each secret must be random and >= 32 bytes.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES_IN=
REFRESH_TOKEN_EXPIRES_IN=

ADMIN_NAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_PHONE=

OTP_EXPIRES_IN=5m
RESEND_API_KEY=
# Email sender ("Name <addr@domain>", domain must be Resend-verified) + logo URL (public deployed image; empty → text fallback)
EMAIL_FROM=
EMAIL_LOGO_URL=

# ======================
# GOOGLE OAUTH
# ======================
GOOGLE_CLIENT_ID=

# ======================
# R2 (Cloudflare R2 object storage, S3-compatible)
# ======================
# Account endpoint, e.g. https://<accountid>.r2.cloudflarestorage.com  (REQUIRED — no default)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mangaka-dev
R2_REGION=auto

OTP_RL_EMAIL_MAX=10
OTP_RL_EMAIL_WINDOW=3600
OTP_RL_IP_MAX=50
OTP_RL_IP_WINDOW=3600
OTP_RL_COOLDOWN=30
# Ngưỡng cảnh báo hạn nộp cho CÔNG VIỆC (task). Cảnh báo cấp CHƯƠNG nay dùng
# ngưỡng theo nhịp phát hành (computeWarningLevel), không đọc biến này.
DEADLINE_WARN_THRESHOLD_HOURS=48
# Chỉ cảnh báo task có tổng thời hạn (deadline − createdAt) > ngưỡng này (giờ). Task ngắn hơn → không cảnh báo (default 48).
TASK_WARN_MIN_LEAD_HOURS=48
DEADLINE_SLOT_GRACE_HOURS=
STORYBOARD_MAX_REVIEW_ROUNDS=8
ORPHAN_ASSET_TTL_HOURS=
TRUST_PROXY_HOPS=
# Comma-separated allowed HTTP/WebSocket origins; production requires a non-empty HTTPS allow-list. No trailing slash.
# e.g. CORS_ORIGINS=https://manga-ecosystem.vercel.app,http://localhost:3000,http://localhost:3001,http://localhost:5173
CORS_ORIGINS=
# Production defaults to HTTPS origins only. Set true only to permit exact http://localhost:<port> or http://127.0.0.1:<port> origins for temporary local development.
ALLOW_INSECURE_LOCAL_CORS=false
# Deployment controls are read from the VPS .env by deploy.yml; they are not GitHub Actions variables.
AI_ENABLED=false
PRODUCTION_HEALTH_URL=
# Guest identity/IP HMAC pepper (B-VOT-03). Production requires a random secret >= 32 bytes.
IDENTITY_HASH_PEPPER=

# AI service (Spec 2) - empty AI_SERVICE_URL means AI disabled
AI_SERVICE_URL=
AI_SERVICE_API_KEY=
AI_HTTP_TIMEOUT_MS=120000

# Spec 15 — Public reader & voting completion
# Production requires a non-empty random CAPTCHA secret.
RECAPTCHA_SECRET=
PUBLIC_SIGN_TTL_SECONDS=900
# Spec 23 — Redis read-cache. false bypasses cache and reads directly from MongoDB.
READ_CACHE_ENABLED=true
PUBLIC_RL_IP_MAX=120
PUBLIC_RL_IP_WINDOW=60
