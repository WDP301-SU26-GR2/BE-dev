{
  "moduleFileExtensions": ["js", "json", "ts", "tsx"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testMatch": ["<rootDir>/**/*.e2e-spec.ts"],
  "testPathIgnorePatterns": ["/integration/", "/flows/"],
  "globalSetup": "<rootDir>/jest-test-environment-setup.ts",
  "transform": {
    "^.+\\.(t|j)sx?$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1",
    "^@react-pdf/renderer$": "<rootDir>/../src/infrastructure/pdf/react-pdf-renderer.jest-mock.ts"
  }
}
