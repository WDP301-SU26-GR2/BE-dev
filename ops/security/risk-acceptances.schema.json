{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mangaka.local/schemas/risk-acceptances.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "acceptances"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "acceptances": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "findingId",
          "scope",
          "rationale",
          "compensatingControls",
          "owner",
          "approvedBy",
          "expiresOn"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^RA-[0-9]{4}-[0-9]{3,}$"
          },
          "findingId": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "pattern": "^target=[^;]+;package=.+$"
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "compensatingControls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "approvedBy": {
            "type": "string",
            "minLength": 1
          },
          "expiresOn": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  }
}
